{
	"latex-workshop.latex.tools": [
		{
			"name": "xelatex-shell-escape",
			"command": "xelatex",
			"args": [
				"-synctex=1",
				"-interaction=nonstopmode",
				"-file-line-error",
				"-shell-escape",
				"%DOC%"
			]
		}
	],
	"latex-workshop.latex.recipes": [
		{
			"name": "XeLaTeX (shell-escape)",
			"tools": ["xelatex-shell-escape"]
		}
	],
	"latex-workshop.latex.recipe.default": "XeLaTeX (shell-escape)"
}
